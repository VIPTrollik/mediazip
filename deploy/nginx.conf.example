# Example server block for the zipbot container behind nginx + certbot.
# Replace dl.example.com; certbot fills in the ssl_certificate lines.

limit_req_zone $binary_remote_addr zone=zipbot_api:10m rate=30r/m;
server_tokens off;  # http context: applies to every server block, incl. the :80 redirect

server {
    listen 80;
    server_name dl.example.com;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name dl.example.com;

    # ssl_certificate     /etc/letsencrypt/live/dl.example.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/dl.example.com/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    client_max_body_size 1k;

    # The token travels in the URL fragment, which browsers never send, so default
    # access logs are safe; keep them minimal anyway.
    access_log /var/log/nginx/zipbot.access.log;

    location /api/ {
        limit_req zone=zipbot_api burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8080;
        include /etc/nginx/zipbot_proxy.conf;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        include /etc/nginx/zipbot_proxy.conf;
    }
}

# /etc/nginx/zipbot_proxy.conf:
#   proxy_http_version 1.1;
#   proxy_set_header Host $host;
#   proxy_set_header X-Forwarded-For $remote_addr;   # overwrite, don't append client-supplied values
#   proxy_set_header X-Forwarded-Proto $scheme;
#   proxy_read_timeout 15s;
