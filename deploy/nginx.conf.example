# Example site for the zipbot container (MediaZip) behind nginx + certbot, included in nginx's
# http context (e.g. a file in sites-enabled). For another host, replace mediazip.download.
#
# It is one plain HTTP server block, so `nginx -t` passes before any certificate exists. Then
# `sudo certbot --nginx -d mediazip.download` adds `listen 443 ssl`, the certificate lines and
# the HTTP → HTTPS redirect to this block itself.
#
# The upstream port is HOST_PORT from .env (8090 in production; docker-compose.yml defaults
# to 8080).

limit_req_zone $binary_remote_addr zone=zipbot_api:10m rate=30r/m;
server_tokens off;  # http context: applies to every server block, incl. certbot's :80 redirect

server {
    listen 80;
    server_name mediazip.download;

    # Browsers ignore HSTS on plain HTTP, so this only takes effect once certbot has made this
    # block serve HTTPS (certbot keeps it in the block it converts).
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    client_max_body_size 1k;

    # The token travels in the URL fragment, which browsers never send, so default
    # access logs are safe; keep them minimal anyway.
    access_log /var/log/nginx/zipbot.access.log;

    location /api/ {
        limit_req zone=zipbot_api burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8090;  # HOST_PORT
        include /etc/nginx/zipbot_proxy.conf;
    }

    location / {
        proxy_pass http://127.0.0.1:8090;  # HOST_PORT
        include /etc/nginx/zipbot_proxy.conf;
    }
}

# /etc/nginx/zipbot_proxy.conf:
#   proxy_http_version 1.1;
#   proxy_set_header Host $host;
#   proxy_set_header X-Forwarded-For $remote_addr;   # overwrite, don't append client-supplied values
#   proxy_set_header X-Forwarded-Proto $scheme;
#   proxy_read_timeout 15s;
