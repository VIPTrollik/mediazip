# Copy to .env and fill in. Never commit .env.
# Bot token: Developer Portal → your app → Bot → Reset Token
DISCORD_TOKEN=
# Public origin of the download page (https; http only for localhost dev)
PUBLIC_BASE_URL=http://localhost:8080
# PUBLIC_BASE_URL=https://mediazip.download   # production

# Optional (defaults shown)
# DISCORD_APPLICATION_ID=        # install link before the bot logs in; afterwards the bot's own id wins
# WEB_HOST=0.0.0.0
# WEB_PORT=8080
# LINK_TTL_MIN=60
# BASKET_TTL_MIN=60
# BASKET_MAX_MESSAGES=10
# MAX_FILES_PER_LINK=100
# MEDIA_TYPES=image,video        # any of image,video,audio, or all (any file: may fail, see README)
# DM_DEBOUNCE_SEC=8
# BASKET_DM=true                 # the basket as one message in the bot DM; false: reply panels only
# MAX_ACTIVE_LINKS_PER_USER=20
# RESOLVE_RATE_PER_MIN=30
# TRUSTED_PROXIES=127.0.0.1          # docker-compose.yml sets 127.0.0.1,$ZIPBOT_GATEWAY
# LOG_LEVEL=INFO
# Google Analytics 4, cookieless (consent denied, no cookies), on /, /privacy and /terms only,
# never on the download page. Unset or empty: no analytics at all. Production uses:
# GA_MEASUREMENT_ID=G-Z8VRMRQ3X4

# docker compose only (read from this file for interpolation; the app ignores them)
# HOST_PORT=8080                  # host side of 127.0.0.1:<port>; production: 8090 (8080 is taken)
# ZIPBOT_SUBNET=172.30.88.0/24    # the zipbot network; change both if it clashes
# ZIPBOT_GATEWAY=172.30.88.1      # (`docker compose down` first); also the default TRUSTED_PROXIES entry
