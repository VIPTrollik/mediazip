# Copy to .env and fill in. Never commit .env.
# Bot token: Developer Portal → your app → Bot → Reset Token
DISCORD_TOKEN=
# Public origin of the download page (https; http only for localhost dev)
PUBLIC_BASE_URL=https://dl.example.com

# Optional (defaults shown)
# WEB_HOST=0.0.0.0
# WEB_PORT=8080
# LINK_TTL_MIN=60
# BASKET_TTL_MIN=60
# BASKET_MAX_MESSAGES=10
# MAX_FILES_PER_LINK=100
# MEDIA_TYPES=image,video        # or: all
# DM_DEBOUNCE_SEC=8
# MAX_ACTIVE_LINKS_PER_USER=20
# RESOLVE_RATE_PER_MIN=30
# TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12
# LOG_LEVEL=INFO
